<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="$(arg name)">

    <!-- A UR arm with an OnRobot gripper standing in a cell. The cell (config/cells/<cell>.yaml of
         ur_workspace_description) gives the furniture around the robot, if any, and how the robot base is
         turned. Every argument but tf_prefix and ip_address is required; the launch files build the whole
         command with ur_onrobot_description.description_command, from configuration files. ip_address is the
         Compute Box of the gripper, needed only by a real gripper over tcp. -->
    <xacro:arg name="tf_prefix" default=""/>
    <xacro:arg name="ip_address" default=""/>

    <xacro:property name="cell"
        value="${xacro.load_yaml('$(find ur_workspace_description)/config/cells/$(arg cell).yaml')}"/>

    <xacro:include filename="$(find ur_onrobot_description)/urdf/ur_onrobot_macro.xacro"/>

    <link name="world"/>

    <xacro:if value="${cell['environment'] != None}">
        <xacro:include filename="$(find ur_workspace_description)/${cell['environment']['file']}"/>
        <xacro:cell_environment environment="${cell['environment']}"/>
    </xacro:if>

    <xacro:ur_onrobot
        parent="world"
        robot_ip="$(arg robot_ip)"
        ur_type="$(arg ur_type)"
        onrobot_type="$(arg onrobot_type)"
        tf_prefix="$(arg tf_prefix)"
        use_fake_hardware="$(arg use_fake_hardware)"
        cable_connector="${cell['robot']['cable_connector']}"
        joint_limits_parameters_file="$(arg joint_limits_parameters_file)"
        kinematics_parameters_file="$(arg kinematics_parameters_file)"
        physical_parameters_file="$(arg physical_parameters_file)"
        visual_parameters_file="$(arg visual_parameters_file)"
        script_filename="$(arg script_filename)"
        output_recipe_filename="$(arg output_recipe_filename)"
        input_recipe_filename="$(arg input_recipe_filename)"
        connection_type="$(arg connection_type)"
        device="$(arg device)"
        ip_address="$(arg ip_address)"
        port="$(arg port)"
        device_address="$(arg device_address)"
        include_gripper_ros2_control="$(arg include_gripper_ros2_control)">
        <origin xyz="0 0 0" rpy="0 0 ${cell['robot']['base_yaw']}"/>
    </xacro:ur_onrobot>

</robot>

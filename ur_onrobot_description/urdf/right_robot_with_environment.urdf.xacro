<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="right_robot_with_environment">

   <!-- Right cell: its environment, the default address of its robot and how the robot base is turned -->
   <xacro:property name="cell_side" value="right"/>
   <xacro:property name="cell_robot_yaw" value="-1.570796327"/>
   <xacro:arg name="robot_ip" default="192.168.1.101"/>

   <xacro:include filename="$(find ur_onrobot_description)/urdf/inc/robot_with_environment.xacro"/>

</robot>

<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Furniture of a cell with two tables, a conveyor between them and safety barriers around the first
       table. Sizes and meshes are those of this furniture; where each piece stands comes from the cell file
       (config/cells/<cell>.yaml, section environment), so the left and right cells share this file.
       All links hang from the link "world", which the including file creates. -->

  <xacro:include filename="$(find ur_workspace_description)/meshes/materials/materials.xacro"/>
  <xacro:property name="cell_meshes" value="package://ur_workspace_description/meshes/environment"/>

  <!-- A table or the conveyor: a mesh to look at, a box to collide with, fixed to the world. -->
  <xacro:macro name="cell_furniture" params="link joint mesh material box position">
    <link name="${link}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${cell_meshes}/${mesh}" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${box}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${joint}" type="fixed">
      <parent link="world"/>
      <child link="${link}"/>
      <origin xyz="${position[0]} ${position[1]} ${position[2]}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- A safety barrier fixed to the first table. position: x y z as text. -->
  <xacro:macro name="cell_barrier" params="name mesh box collision_xyz collision_rpy position">
    <link name="safety_barrier_${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${cell_meshes}/${mesh}" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="workspace_safety_yellow"/>
      </visual>
      <collision>
        <origin xyz="${collision_xyz}" rpy="${collision_rpy}"/>
        <geometry>
          <box size="${box}"/>
        </geometry>
      </collision>
    </link>
    <joint name="table_to_barrier_${name}" type="fixed">
      <parent link="table_top"/>
      <child link="safety_barrier_${name}"/>
      <origin xyz="${position}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="cell_environment" params="environment">
    <xacro:property name="second" value="${environment['second_barrier']['position']}"/>
    <xacro:property name="back" value="${environment['back_barrier']}"/>
    <xacro:property name="front" value="${environment['front_barrier']}"/>
    <xacro:property name="top" value="${environment['top_barrier']}"/>

    <xacro:cell_furniture link="table_top" joint="world_to_table" mesh="table.stl"
      material="workspace_light_gray" box="1.2 0.7 0.75" position="${environment['table']}"/>
    <xacro:cell_furniture link="conveyor_belt" joint="world_to_conveyor" mesh="conveyor.stl"
      material="workspace_dark_gray" box="2.05 0.825 0.05" position="${environment['conveyor']}"/>
    <xacro:cell_furniture link="table_top_2" joint="world_to_table_2" mesh="table.stl"
      material="workspace_light_gray" box="1.2 0.7 0.75" position="${environment['second_table']}"/>

    <!-- Two narrow barriers at the ends of the table, two wide ones along it, and the top. -->
    <xacro:cell_barrier name="${environment['first_barrier']['side']}" mesh="narrow_safety_barrier.stl"
      box="1.2 0.05 0.8" collision_xyz="0 0 0.4" collision_rpy="0 0 1.5708" position="0 1.55 0.75"/>
    <xacro:cell_barrier name="${environment['second_barrier']['side']}" mesh="narrow_safety_barrier.stl"
      box="1.2 0.05 0.8" collision_xyz="0 0 0.4" collision_rpy="0 0 1.5708"
      position="${second[0]} ${second[1]} ${second[2]}"/>
    <xacro:cell_barrier name="back" mesh="wide_safety_barrier.stl"
      box="0.05 0.7 0.8" collision_xyz="0 0 0.4" collision_rpy="0 0 1.5708"
      position="${back[0]} ${back[1]} ${back[2]}"/>
    <xacro:cell_barrier name="front" mesh="wide_safety_barrier.stl"
      box="0.05 0.7 0.8" collision_xyz="0 0 0.4" collision_rpy="0 0 1.5708"
      position="${front[0]} ${front[1]} ${front[2]}"/>
    <xacro:cell_barrier name="top" mesh="top_safety_barrier.stl"
      box="0.7 1.2 0.01" collision_xyz="0 0 0" collision_rpy="0 0 0"
      position="${top[0]} ${top[1]} ${top[2]}"/>
  </xacro:macro>

</robot>

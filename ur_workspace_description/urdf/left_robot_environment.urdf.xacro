<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="workspace_environment">

  <!-- Left cell: where each piece of the environment stands (the pieces are in inc/cell_environment.xacro) -->
  <xacro:property name="cell_with_world_link" value="false"/>
  <xacro:property name="cell_table_xyz" value="-0.15 -0.65 -0.75"/>
  <xacro:property name="cell_conveyor_xyz" value="-1.02 -0.70 -0.75"/>
  <xacro:property name="cell_table_2_xyz" value="-1.79 -0.65 -0.75"/>
  <xacro:property name="cell_first_barrier" value="right"/>
  <xacro:property name="cell_second_barrier" value="left"/>
  <xacro:property name="cell_second_barrier_xyz" value="0 -0.05 0.75"/>
  <xacro:property name="cell_back_barrier_xyz" value="0.85 -0.05 0.75"/>
  <xacro:property name="cell_front_barrier_xyz" value="-0.95 -0.05 0.75"/>
  <xacro:property name="cell_top_barrier_xyz" value="0 -0.05 1.9"/>

  <xacro:include filename="$(find ur_workspace_description)/urdf/inc/cell_environment.xacro"/>

</robot>
